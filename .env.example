# --- Server ---
# Postgres
POSTGRES_USER=photowall
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=photowall
DATABASE_URL=postgres://photowall:change-me-postgres@db:5432/photowall

# Public URL the app is served at (used in QR codes, share links)
PUBLIC_BASE_URL=http://localhost

# Auth secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-jwt-32-bytes-hex
QR_TOKEN_SECRET=change-me-qr-32-bytes-hex

# Passwords
PARTY_PASSWORD=change-me-party
ADMIN_PASSWORD=change-me-admin

# Bearer token for the SD-card watcher to authenticate to /api/upload/sdcard
WATCHER_TOKEN=change-me-watcher

# --- Caddy (production only) ---
# Domain Caddy should serve on, e.g. photowall.example.com
CADDY_DOMAIN=:80
# Email for ACME (Let's Encrypt) account; leave blank for staging/local
CADDY_EMAIL=

# --- Watcher (laptop side) ---
# Where the watcher should POST uploads
SERVER_URL=http://localhost
